{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {"api/studio.js": {"maxDuration": 300,"includeFiles": "public/**"}},
  "rewrites": [
    {"source": "/auth/:path*", "destination": "/api/studio"},
    {"source": "/api/drive/:path*", "destination": "/api/studio"},
    {"source": "/api/workspaces/:path*", "destination": "/api/studio"},
    {"source": "/api/library/:path*", "destination": "/api/studio"}
  ]
}
